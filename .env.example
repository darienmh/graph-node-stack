# graph-node stack — environment template.
# Copy to `.env` and fill in. NEVER commit the real .env (see .gitignore).
#
#   cp .env.example .env

# ─── Secrets ─────────────────────────────────────────────────────────────────

# Postgres superuser password for the `graph-node` role. graph-node uses the SAME
# value to connect (interpolated into config.toml). On a fresh volume Postgres
# initialises the role with this; if you change it later you must ALTER the role
# too (it is only applied on first init).
POSTGRES_PASSWORD=

# Polygon (matic) RPC endpoints — full URLs incl. token, e.g.
#   https://polygon-mainnet.core.chainstack.com/<TOKEN>
# rpc-lb round-robins requests across these three. Use dedicated tokens per
# deployment to avoid doubling load on shared endpoints.
RPC_1=
RPC_2=
RPC_3=

# Comma-separated API keys accepted by the query/admin/ipfs routers
# (validated by the graph-auth forwardAuth middleware). e.g. key1,key2
API_KEYS=

# ─── Postgres tuning ─────────────────────────────────────────────────────────
# Defaults sized for a small ~7.6 GB box. On a bigger server raise these:
#   shared_buffers ~= 25% RAM, effective_cache_size ~= 50-75% RAM.
PG_MAX_CONNECTIONS=50
PG_SHARED_BUFFERS=1536MB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=512MB
PG_MAX_WAL_SIZE=4GB
PG_MIN_WAL_SIZE=1GB
PG_SHM_SIZE=512m

# ─── Public hostnames (Traefik routers) ──────────────────────────────────────
# The Host(...) rules in docker-compose.yml read these. One set per deployment.
GRAPH_HOST_QUERY=graph.example.com
GRAPH_HOST_ADMIN=graph-admin.example.com
GRAPH_HOST_STATUS=graph-status.example.com
GRAPH_HOST_IPFS=graph-ipfs.example.com
