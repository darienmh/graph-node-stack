# Traefik — environment template. Copy to `.env` (do not commit).
#
#   cp .env.example .env

# Cloudflare API token with Zone:DNS:Edit on your zone. Traefik's lego cloudflare
# provider reads this var name for the DNS-01 ACME challenge (wildcard-capable).
#
# NOTE: if the token has IP filtering enabled, it is bound to specific source IPs.
# It must allow this server's egress IP, and Docker must NOT have IPv6 enabled on
# the bridge (containers egress via the host's IPv4 NAT). A token scoped to
# another server's IP will fail with Cloudflare error 9109.
CF_EDIT_ZONE=
